    local hi = _byte(code, pos + 1, pid)
    return lo + hi * 256
end

-- Read signed i16 at 1-based offset.
local function read_i16(code, pos, pid)
    local v = read_u16(code, pos, pid)
    if v >= 32768 then v = v - 65536 end
    return v
