-- runtime
-- Generated; do not edit by hand.

local _ENV_ = _ENV or getfenv(1)
local _select = select
local _error = error
local _pcall = pcall
local _tostring = tostring
local _type = type
local _sbyte = string.byte
local _ssub = string.sub
local _schar = string.char
local _tunpack = table.unpack or unpack
local _tcreate = function(n) local t = {} for i=1,n do t[i] = false end return t end
local _floor = math.floor
local _xor = bit32.bxor
local _tconcat = table.concat
local _tpack = table.pack or function(...)
    local t = {...}
    t.n = _select("#", ...)
    return t
end

local _KAS = {
{% for k in keys_a %}    { {{ k }} },
{% endfor %}}
local _KBS = {
{% for k in keys_b %}    { {{ k }} },
{% endfor %}}

local _k0 = {{ k0 }}
local _k1 = {{ k1 }}

-- _mul32: compute (a * b) % 2^32 avoiding IEEE-754 double precision loss.
-- Reused from the byte-cipher; defined at module scope for _decrypt use.
local function _mul32_const(a, b)
    local a_lo = a % 65536
    local a_hi = (a - a_lo) / 65536
    local b_lo = b % 65536
    local b_hi = (b - b_lo) / 65536
    local mid = (a_lo * b_hi + a_hi * b_lo) % 65536
    return (a_lo * b_lo + mid * 65536) % 4294967296
end

-- Plan 32 Task 2: _decrypt now accepts a bs_seed that is the byte-cipher's
-- final LCG state after pre-decrypting the bytecode. Mixing it in means that
-- recovering constants statically requires simulating the full bytecode LCG.
local function _decrypt(enc, proto_id, bs_seed)
    local ka = _KAS[proto_id + 1]
    local kb = _KBS[proto_id + 1]
    local out = {}
    local salt_term = (proto_id * 7919) % 4294967296
    local mix = bs_seed
    for i = 1, #enc do
        local b = _sbyte(enc, i)
        local idx = ((i - 1) % 32) + 1
        local pos = ((i - 1) + salt_term + (mix % 256)) % 256
        local plain = _xor(_xor(_xor(b, ka[idx]), pos), kb[idx])
        out[i] = _schar(plain)
        mix = (_mul32_const(mix, 1103515245) + plain + 12345) % 4294967296
    end
    return _tconcat(out)
end

local function _cw(bytes) return { _e = bytes } end

-- Plan 32 Task 2: _const forwards bs_seed to _decrypt so the constant cipher
-- is tangled with the byte-cipher final state.
local function _const(consts, idx, proto_id, bs_seed)
    local c = consts[idx]
    if type(c) == "table" and c._e then
        local raw = _decrypt(c._e, proto_id, bs_seed)
        local tag = _sbyte(raw, 1)
        local len_lo = _sbyte(raw, 2)
        local len_hi = _sbyte(raw, 3)
        local n = len_lo + len_hi * 256
        if tag == 0 then
            c = _ssub(raw, 4, 3 + n)
        elseif tag == 1 then
            c = string.unpack("<d", raw, 4)
        elseif tag == 2 then
            c = _sbyte(raw, 4) ~= 0
        else
            c = nil
        end
        consts[idx] = c
    end
    return c
end

-- Constant pools per proto.
local CONSTS = {
{% for proto_consts in consts %}    { {{ proto_consts }} },
{% endfor %}}

-- Bytecode strings per proto.
local CODE = {
{% for code_lit in codes %}    {{ code_lit }},
{% endfor %}}

-- Forward-declare vm_call so closures (Closure op) can reference it.
local vm_call

vm_call = function(proto_id, args, nargs, upvals)
    local code = CODE[proto_id + 1]
    local consts = CONSTS[proto_id + 1]

    -- Stateful LCG keystream (Plan 32 Task 1): pre-decrypt all bytecode bytes
    -- using a single sequential pass so the LCG state is always coherent.
    -- The dispatch loop and handler groups then read from `plain[]` directly,
    -- which avoids state desync when jumps cause bytecodes to be re-visited.
    --
    -- _mul32: compute (a * b) % 2^32 avoiding IEEE-754 double precision loss.
    -- Doubles have 53-bit mantissa; a*b can reach ~4.7e18 (> 2^53) for u32 inputs.
    -- Split into 16-bit halves: (a_hi*2^16 + a_lo)*(b_hi*2^16 + b_lo) mod 2^32
    -- = ((a_hi*b_lo + a_lo*b_hi) mod 2^16)*2^16 + a_lo*b_lo, all terms < 2^53.
    local function _mul32(a, b)
        local a_lo = a % 65536
        local a_hi = (a - a_lo) / 65536
        local b_lo = b % 65536
        local b_hi = (b - b_lo) / 65536
        local mid = (a_lo * b_hi + a_hi * b_lo) % 65536
        return (a_lo * b_lo + mid * 65536) % 4294967296
    end

    -- Pre-decrypt all bytecodes in one sequential pass.
    local _bs = (_mul32(proto_id + 1, 2654435761) + _k0) % 4294967296
    local plain = {}
    for _i = 1, #code do
        local _raw = _sbyte(code, _i)
        local _pos_mix = (_mul32(_i, _k1) + _k0 + _mul32(proto_id, 2654435761)) % 4294967296
        local _ks = _xor(_bs % 256, _pos_mix % 256)
        _bs = (_mul32(_bs, 1103515245) + _ks + 12345) % 4294967296
        plain[_i] = _xor(_raw, _ks)
    end
    -- Plan 32 Task 2: after the pre-decryption pass, _bs holds the byte-cipher's
    -- final LCG state. Save it as the seed for the constant-pool cipher.
    local _const_bs_seed = _bs

    -- Helpers reading from the pre-decrypted `plain` table (no LCG needed here).
    local function read_u16(_, pos, _)
        return plain[pos] + plain[pos + 1] * 256
    end

    -- Read signed i16 at 1-based offset from plain[].
    local function read_i16(_, pos, _)
        local v = plain[pos] + plain[pos + 1] * 256
        if v >= 32768 then v = v - 65536 end
        return v
    end

    local handle_group_a, handle_group_b, handle_group_c

-- Group A: arithmetic + comparison (13 ops)
handle_group_a = function(op, regs, code, pc, proto_id, consts)
    if op == {{ ops.Add }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = regs[b] + regs[c]
        return pc, "continue"
    elseif op == {{ ops.Sub }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = regs[b] - regs[c]
        return pc, "continue"
    elseif op == {{ ops.Mul }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = regs[b] * regs[c]
        return pc, "continue"
    elseif op == {{ ops.Div }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = regs[b] / regs[c]
        return pc, "continue"
    elseif op == {{ ops.Mod }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = regs[b] % regs[c]
        return pc, "continue"
    elseif op == {{ ops.Pow }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = regs[b] ^ regs[c]
        return pc, "continue"
    elseif op == {{ ops.Concat }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = _tostring(regs[b]) .. _tostring(regs[c])
        return pc, "continue"
    elseif op == {{ ops.Lt }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = regs[b] < regs[c]
        return pc, "continue"
    elseif op == {{ ops.Le }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = regs[b] <= regs[c]
        return pc, "continue"
    elseif op == {{ ops.Eq }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = regs[b] == regs[c]
        return pc, "continue"
    elseif op == {{ ops.Not }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = not regs[b]
        return pc, "continue"
    elseif op == {{ ops.Neg }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = -regs[b]
        return pc, "continue"
    elseif op == {{ ops.Len }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = #regs[b]
        return pc, "continue"
    end
    return pc, "miss"
end

-- Group B: load / move / global / table / upval / vararg / superop (14 ops)
-- _const_bs_seed: byte-cipher final LCG state (Plan 32 Task 2) for constant decryption.
handle_group_b = function(op, regs, code, pc, proto_id, consts, upvals, frame_varargs, _const_bs_seed)
    if op == {{ ops.LoadNil }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = nil
        return pc, "continue"
    elseif op == {{ ops.LoadTrue }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = true
        return pc, "continue"
    elseif op == {{ ops.LoadFalse }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = false
        return pc, "continue"
    elseif op == {{ ops.LoadConst }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = _const(consts, b + 1, proto_id, _const_bs_seed)
        return pc, "continue"
    elseif op == {{ ops.Move }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = regs[b]
        return pc, "continue"
    elseif op == {{ ops.GetGlobal }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = _ENV_[_const(consts, b + 1, proto_id, _const_bs_seed)]
        return pc, "continue"
    elseif op == {{ ops.SetGlobal }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        _ENV_[_const(consts, a + 1, proto_id, _const_bs_seed)] = regs[b]
        return pc, "continue"
    elseif op == {{ ops.NewTable }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = {}
        return pc, "continue"
    elseif op == {{ ops.GetTable }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = regs[b][regs[c]]
        return pc, "continue"
    elseif op == {{ ops.SetTable }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local c = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a][regs[b]] = regs[c]
        return pc, "continue"
    elseif op == {{ ops.GetUpval }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local idx = read_u16(code, pc, proto_id); pc = pc + 2
        local cell = upvals[idx + 1]
        regs[a] = cell._t[cell._k]
        return pc, "continue"
    elseif op == {{ ops.SetUpval }} then
        local idx = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local cell = upvals[idx + 1]
        cell._t[cell._k] = regs[b]
        return pc, "continue"
    elseif op == {{ ops.Vararg }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a] = frame_varargs
        return pc, "continue"
    elseif op == {{ ops.LoadConstLoadConst }} then
        local a1 = read_u16(code, pc, proto_id); pc = pc + 2
        local b1 = read_u16(code, pc, proto_id); pc = pc + 2
        local a2 = read_u16(code, pc, proto_id); pc = pc + 2
        local b2 = read_u16(code, pc, proto_id); pc = pc + 2
        regs[a1] = _const(consts, b1 + 1, proto_id, _const_bs_seed)
        regs[a2] = _const(consts, b2 + 1, proto_id, _const_bs_seed)
        return pc, "continue"
    end
    return pc, "miss"
end

-- Group C: control flow / calls / closures (9 ops)
handle_group_c = function(op, regs, code, pc, proto_id, consts, upvals, frame_varargs)
    if op == {{ ops.Call }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local n = read_i16(code, pc, proto_id); pc = pc + 2
        local fn = regs[b]
        local call_args = {}
        for i = 1, n do
            call_args[i] = regs[b + i]
        end
        local result = fn(_tunpack(call_args, 1, n))
        if a ~= 0xFFFF then
            regs[a] = result
        end
        return pc, "continue"
    elseif op == {{ ops.Return }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        if a == 0xFFFF then
            return pc, "return", nil
        else
            return pc, "return", regs[a]
        end
    elseif op == {{ ops.Jmp }} then
        local delta = read_i16(code, pc, proto_id); pc = pc + 2
        pc = pc + delta
        return pc, "continue"
    elseif op == {{ ops.JmpIfTrue }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local delta = read_i16(code, pc, proto_id); pc = pc + 2
        if regs[a] then
            pc = pc + delta
        end
        return pc, "continue"
    elseif op == {{ ops.JmpIfFalse }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local delta = read_i16(code, pc, proto_id); pc = pc + 2
        if not regs[a] then
            pc = pc + delta
        end
        return pc, "continue"
    elseif op == {{ ops.Closure }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local pid = read_u16(code, pc, proto_id); pc = pc + 2
        -- Read (and discard) the closure_idx operand: must advance LCG for sync.
        read_u16(code, pc, proto_id); pc = pc + 2
        local n_upvals = read_u16(code, pc, proto_id); pc = pc + 2
        local new_upvals = {}
        for u = 1, n_upvals do
            local kind = plain[pc]; pc = pc + 1
            local payload = read_u16(code, pc, proto_id); pc = pc + 2
            if kind == 0 then
                -- LocalReg: build a cell referencing current frame's regs.
                new_upvals[u] = { _t = regs, _k = payload }
            else
                -- ParentUpval: share the existing cell from this frame's upvals.
                new_upvals[u] = upvals[payload + 1]
            end
        end
        local captured = new_upvals
        regs[a] = function(...)
            local pa = { ... }
            local n = _select("#", ...)
            return vm_call(pid, pa, n, captured)
        end
        return pc, "continue"
    elseif op == {{ ops.CallVar }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local b = read_u16(code, pc, proto_id); pc = pc + 2
        local n = read_i16(code, pc, proto_id); pc = pc + 2
        local sp = read_u16(code, pc, proto_id); pc = pc + 2
        local mode = read_i16(code, pc, proto_id); pc = pc + 2
        local fn = regs[b]
        local call_args = {}
        local total_n = n
        for i = 1, n do
            call_args[i] = regs[b + i]
        end
        if sp ~= 0xFFFF then
            local sp_tbl = regs[sp]
            local m = sp_tbl.n or 0
            for i = 1, m do
                call_args[total_n + 1] = sp_tbl[i]
                total_n = total_n + 1
            end
        end
        if mode == 0 then
            fn(_tunpack(call_args, 1, total_n))
        elseif mode == 1 then
            local r = fn(_tunpack(call_args, 1, total_n))
            if a ~= 0xFFFF then
                regs[a] = r
            end
        else
            local results = _tpack(fn(_tunpack(call_args, 1, total_n)))
            regs[a] = results
        end
        return pc, "continue"
    elseif op == {{ ops.BuildResults }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local sp = read_u16(code, pc, proto_id); pc = pc + 2
        read_u16(code, pc, proto_id); pc = pc + 2  -- br_idx: read to advance LCG, discard value
        local n_values = read_u16(code, pc, proto_id); pc = pc + 2
        local tbl = {}
        local count = 0
        for _ = 1, n_values do
            local r = read_u16(code, pc, proto_id); pc = pc + 2
            count = count + 1
            tbl[count] = regs[r]
        end
        if sp ~= 0xFFFF then
            local sp_tbl = regs[sp]
            local m = sp_tbl.n or 0
            for i = 1, m do
                count = count + 1
                tbl[count] = sp_tbl[i]
            end
        end
        tbl.n = count
        regs[a] = tbl
        return pc, "continue"
    elseif op == {{ ops.ReturnMulti }} then
        local a = read_u16(code, pc, proto_id); pc = pc + 2
        local tbl = regs[a]
        return pc, "return_multi", tbl
    end
    return pc, "miss"
end

    -- Prologue: read from pre-decrypted plain[] table.
    local num_params = plain[1]
    local num_regs = plain[2] + plain[3] * 256
    -- plain[4] = num_upvals (not used at runtime; decrypted above)
    local is_vararg = plain[5] == 1
    local inv = {}
    for i = 1, {{ opcodes | length }} do
        inv[i] = plain[5 + i]
    end
    upvals = upvals or {}
    local regs = _tcreate(num_regs + 1)
    for i = 1, num_params do
        regs[i - 1] = args[i]
    end
    local frame_varargs
    if is_vararg then
        local vn = nargs - num_params
        if vn < 0 then vn = 0 end
        frame_varargs = {}
        for i = 1, vn do
            frame_varargs[i] = args[num_params + i]
        end
        frame_varargs.n = vn
    end
    local pc = {{ opcodes | length }} + 6
    local code_len = #code
    while pc <= code_len do
        local raw = plain[pc]
        local op = inv[raw]
        pc = pc + 1
        local status, val
        pc, status = handle_group_a(op, regs, code, pc, proto_id, consts)
        if status == "miss" then
            pc, status = handle_group_b(op, regs, code, pc, proto_id, consts, upvals, frame_varargs, _const_bs_seed)
        end
        if status == "miss" then
            pc, status, val = handle_group_c(op, regs, code, pc, proto_id, consts, upvals, frame_varargs)
        end
        if status == "miss" then
            _error(_tostring(op))
        end
        if status == "return" then
            return val
        end
        if status == "return_multi" then
            return _tunpack(val, 1, val.n)
        end
        -- status == "continue" — fall through to next iteration
    end
    return nil
end

-- Bootstrap: main proto is index 0; forward varargs.
local main_args = { ... }
local main_n = _select("#", ...)
return vm_call(0, main_args, main_n, {})
